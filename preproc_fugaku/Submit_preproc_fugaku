#!/bin/bash
LANG=

. ../scripts/setenv

#set -ex

echo "`date +%s.%N` #Submit at `date`"

if [ $# -ne 7 ] ; then
    cat << EOF >&2
usage: $0 TimeLimit NumNodes InputFile OutputDir Mode [submit-option]
The TimeLimit is the maximum of execution time with the format hh:mm:ss.
The NumNodes is the number of nodes
The NumProcs is the number of processes for each node
The NumThreads is the number of threads for each task
The InputFile is the directory contains input fasta files
The OutputDir is the directoy where alignment results are stored
The Mode is one from {uniref90, pdb70, mgnify, small_bfd, bfd}

example: $0 2:00:00 4 input.fasta alignment mode 0
EOF
    exit 1
fi

TimeLimit="$1" && shift
NumNodes="$1" && shift
NumProcs="$1" && shift
NumThreads="$1" && shift
InputFile="$1" && shift
OutputDir="$1" && shift
Mode="$1" && shift

# Check NumNodes
if [[ ${IS_FUGAKU} == 1 ]]; then
    if [[ $Mode = "bfd" ]]; then
	if (( $NumNodes < 26 )); then
	    echo "NumNodes must be >= 26 to use bfd." >&2
	    exit
	fi
    else
	if (( $NumNodes < 4 )); then
	    echo "NumNodes must be >= 4 to cache uniref90/pdb70/mgnify/small_bfd." >&2
	    exit
	fi
    fi
fi

LocalTempSize=0Gi

# if [[ $Mode = "uniref90" ]]; then
#     LocalTempSize=64Gi # 62.4 GiB
# elif [[ $Mode = "pdb70" ]]; then
#     LocalTempSize=57Gi # 56.0 GiB
# elif [[ $Mode = "mgnify" ]]; then
#     LocalTempSize=65Gi # 63.9 GiB
# elif [[ $Mode = "small_bfd" ]]; then
#     LocalTempSize=18Gi # 16.9 GiB
# elif [[ $Mode = "bfd" ]]; then
#     LocalTempSize=17Gi # 15.7 GiB
# else
#     echo "Invalid Mode: $Mode" >&2
#     exit
# fi

### The directory where data is stored
DataDir="$DATADIR"

echo DataDir is $DataDir

### WORKER script
WORKER="worker.sh"

# Select Resource Group
RSC_GRP=small

### Create log directory
MyDir=`readlink -f "$0" | xargs dirname`
MyName=`basename "$0"`
Time=`date "+%y%m%d%H%M%S%3N"`
HostName=`hostname | awk -F . '{ print $1; }'`
JobName="$MyName.$Time"

LogDir="$MyDir/log"/"$JobName"
mkdir -p "$LogDir" || exit

###

cp "$MyDir/$0" $LogDir
cp ${MyDir}/${WORKER} ${LogDir}

git rev-parse HEAD 2>&1 > "$LogDir/git_hash"

### Generate qsub script
ScriptFile="$LogDir/script"

cat << EOF > "$ScriptFile"
#!/bin/bash
#PJM -L rscgrp=${RSC_GRP}
#PJM -L elapse=$TimeLimit
#PJM -L node=${NumNodes}
##:strict,freq=2200
#PJM --rsc-list "retention_state=0"
#PJM -j
#PJM -S

hostname
export BaseDir="$MyDir"

LogDir="$LogDir"
if [ ! -d "\$LogDir" ] ; then
    echo "\$LogDir: not a directory" >&2
    exit 1
fi

printenv > "$LogDir/environ"

### The directory where data is stored
DataDir="$DataDir"

###
WORKER=${WORKER}

source ../scripts/setenv

$LogDir/$WORKER $InputFile $OutputDir $NumNodes $NumProcs $NumThreads $Mode 2>&1 | tee "$LogDir/output"


EOF

#cat $BaseFile >> "$ScriptFile"

echo ---------------
echo Job information
echo ---------------
echo NumNodes: $NumNodes
echo LogDir: $LogDir

DoSubmitJob=0
if [[ ${IS_FUGAKU} == 1 ]]; then
    if [[ `hostname` =~ fn01sv0[0-9] ]] ; then
	DoSubmitJob=1
	SubmitCommand=pjsub

	# To use LLIO (node-temporary)
	QsubArgs+=("--llio localtmp-size=$LocalTempSize")
    fi

elif [[ ${IS_ABCI} == 1 ]]; then
    if [[ -n `hostname | grep -e ^es1 -e ^es2` ]]; then
	DoSubmitJob=1
    fi
    SubmitCommand=qsub

    QsubArgs+=("-l ${ABCI_RESOURCE}=${NumNodes}")
    QsubArgs+=("-cwd")
fi

if [[ ${DoSubmitJob} == 1 ]]; then
    # add group option
    QsubArgs+=("$PJSUB_OPT")

    QsubArgs+=("$ScriptFile")

    ### Execute qsub command
    echo "`date +%s.%N` #qsub"
    echo "> pjsub ${QsubArgs[@]} $@"
    ${SubmitCommand} ${QsubArgs[@]} "$@"

else
    # On compute node
    bash $ScriptFile 2>&1 | tee ${LogDir}/stdout.txt
fi
# End of file
