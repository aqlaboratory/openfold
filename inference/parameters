SampleDir=/vol0003/share/hp210263/OpenFold/sample/inference

PARAMS=(
    python3
    $OPENFOLDDIR/run_pretrained_openfold.py
    $SampleDir/T1084/input
    $DataDir/pdb_mmcif/mmcif_files
    --model_device cpu
    --jax_param_path $DataDir/params/params_model_1.npz
    --output_dir $LOGDIR
