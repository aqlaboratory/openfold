MMCIFCache=/vol0006/ra000018/data/OpenFold/sample/training/mmcif_cache.json

InputFasta=/vol0006/ra000018/data/u10271/OpenFold/openfold/inference/multi_test/input.fasta
AlignmentDir=/home/u10271/ra000018/OpenFold/openfold/inference/multi_test/alignment
OutputDir=/home/u10271/ra000018/OpenFold/openfold/inference/multi_test/output

PARAMS=(
    python3
    $OPENFOLDDIR/run_pretrained_openfold_multi.py
    $InputFasta
    $OutputDir
    $DataDir/pdb_mmcif/mmcif_files
    --model_device cpu
    --jax_param_path $DataDir/params/params_model_1.npz
    --kalign_binary_path $PREFIX/bin/kalign
    --use_precomputed_alignments $AlignmentDir
    --obsolete_pdbs_path $DataDir/pdb_mmcif/obsolete.dat
    --max_template_date 2021-10-10
    --release_dates_path $MMCIFCache
    --timeout 3600
    --first_lower
)

source $OPENFOLDDIR/scripts/setenv

# for Torch Extensions
export TORCH_EXTENSIONS_DIR=$TMPDIR

export LD_PRELOAD=$PREFIX/lib/libtcmalloc.so
export OMP_NUM_THREADS=48
export OPENMM_CPU_THREADS=48
