export IS_ABCI=0
export IS_FUGAKU=0
if [[ -n `hostname | grep abci` ]]; then
    export IS_ABCI=1
elif [[ -e ~/.is_fugaku ]]; then
    export IS_FUGAKU=1
fi

if [[ ${IS_FUGAKU} == 1 ]]; then
    module purge
    module load lang/tcsds-1.2.35
fi

############################################################
# Please set PREFIX, OPENFOLDDIR, DATADIR, PJSUB_OPT

if [[ ${IS_FUGAKU} == 1 ]]; then
    export PREFIX=/vol0006/ra000018/data/u10130/openfold_install
    export OPENFOLDDIR=/vol0006/ra000018/data/u10130/repo/openfold
    export DATADIR=/vol0003/share/hp210263/OpenFold/data
    export PJSUB_OPT="-g ra000018 -x PJM_LLIO_GFSCACHE=/vol0006"
    export NUM_CORES=48
elif [[ ${IS_ABCI} == 1 ]]; then
    export OPENFOLDVENV=/home/acd13359ld/venv/openfold_fugaku
    export PREFIX=${OPENFOLDVENV}/tools_install
    export OPENFOLDDIR=/home/acd13359ld/repo/openfold
    export DATADIR=/groups/4/gcd50734/openfold
    export PJSUB_OPT="-g gcd50734"
    export NUM_CORES=40
fi

############################################################

[ -z "$PREFIX" ] && echo "PREFIX is not defined" && exit 1
[ -z "$OPENFOLDDIR" ] && echo "OPENFOLDDIR is not defined" && exit 1
[ -z "$DATADIR" ] && echo "DATADIR is not defined" && exit 1

export WORKDIR=$OPENFOLDDIR/third_party

if [[ ${IS_FUGAKU} == 1 ]]; then
    export TMPDIR=/worktmp
elif [[ ${IS_ABCI} == 1 ]]; then
    export TMPDIR=/tmp
fi
export TEST_TMPDIR=$TMPDIR     # for bazel
export XDG_CACHE_HOME=$TMPDIR  # for cache

export PATH=$PREFIX/bin:$PATH
export LD_LIBRARY_PATH=/lib64:$PREFIX/lib:$LD_LIBRARY_PATH

if [[ ${IS_ABCI} == 1 ]]; then
    . /etc/bashrc
    module purge
    module load gcc/11.2.0 python/3.7/3.7.13 openmpi/4.0.5
    python3 -m venv ${OPENFOLDVENV}
    source ${OPENFOLDVENV}/bin/activate
fi
