# a preprocessed alignments directory
AlignmentDir=example/alignments_smallbfd

# mmcif_cache.json and chain_data_cache.json
MMCIFCache=
ChainDataCache=

# mmcif files and obsolete.dat
MMCIFDir=$DataDir/pdb_mmcif/mmcif_files
MMCIFObso=$DataDir/pdb_mmcif/obsolete.dat

PARAMS=(
    python3
    $OPENFOLDDIR/train_openfold.py
    $MMCIFDir
    $AlignmentDir
    $MMCIFDir
    $LOGDIR
    2021-10-10
    --template_release_dates_cache_path $MMCIFCache
    --seed 42
    --deepspeed_config_path $DeepSpeedConfig
    --checkpoint_every_epoch
    --train_chain_data_cache_path $ChainDataCache
    --replace_sampler_ddp=True
    --num_nodes ${NumNodes}
    --obsolete_pdbs_file_path $MMCIFObso
    --kalign_binary_path $PREFIX/bin/kalign
)

source $OPENFOLDDIR/scripts/setenv

# for Torch Extensions
export TORCH_EXTENSIONS_DIR=$TMPDIR

export OMPI_COMM_WORLD_RANK=$PMIX_RANK
export OMPI_COMM_WORLD_LOCAL_RANK=$PLE_RANK_ON_NODE
export LOCAL_RANK=$OMPI_COMM_WORLD_LOCAL_RANK

export LD_PRELOAD=$PREFIX/lib/libtcmalloc.so
export OMP_NUM_THREADS=48
export PL_TORCH_DISTRIBUTED_BACKEND=mpi

# for multi-node training using PyTorch Lightning
export NODE_RANK=$PMIX_RANK
