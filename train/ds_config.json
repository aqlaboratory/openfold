{
  "zero_optimization": {
    "device": "cpu",
    "stage": 2,
    "allgather_partitions": false,
    "allgather_bucket_size": 1000000000.0,
    "reduce_bucket_size": 1000000000.0,
    "overlap_comm": true,
    "reduce_scatter": false
  },
  "optimizer": {
    "type": "Adam",
    "params": {
      "torch_adam": true,
      "lr": 0.001,
      "betas": [
        0.8,
        0.999
      ],
      "eps": 1e-8,
      "weight_decay": 3e-7
    }
  },
  "flops_profiler": {
    "enabled": false,
    "profile_step": 1,
    "module_depth": -1,
    "top_modules": 3,
    "detailed": false
  },
  "activation_checkpointing": {
    "partition_activations": true,
    "cpu_checkpointing": false,
    "profile": false
  }
}
